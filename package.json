{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/checks/timeStepCli.ts --scn SCN-FIT-012 --check ci-run-time -- vitest run",
    "mutation": "SPEC_CONTROLLER_SOURCE_ROOT=\"$PWD\" tsx tests/checks/mutationScoreCli.ts --scn SCN-FIT-002 --check mutation -- stryker run",
    "mutation:score": "tsx tests/checks/mutationScoreReaderCli.ts --scn SCN-FIT-002 --check mutation",
    "timing:score": "tsx tests/checks/timingReaderCli.ts --check ci-run-time",
    "cucumber": "tsx tests/checks/timeStepCli.ts --scn SCN-FIT-013 --check ci-run-time -- cucumber-js",
    "build": "pnpm -r build",
    "spec-controller": "spec-controller",
    "lint:scn-subissues": "tsx tests/checks/lintScnSubIssuesCli.ts",
    "lint:boundaries": "depcruise packages && eslint --config eslint.boundaries.mjs packages",
    "lint:publint": "publint --pack pnpm packages/core && publint --pack pnpm packages/spec-controller",
    "lint:published-types": "pnpm exec attw --profile esm-only \"$(pnpm --silent --filter @3f-consulting/spec-controller-core pack --pack-destination \"$(mktemp -d)\" | tail -1)\""
  },
  "specController": {
    "runners": {
      "unit": "vitest",
      "integration": "cucumber-js"
    },
    "notChecks": [
      "ci.yml:ci:actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
      "ci.yml:ci:actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
      "ci.yml:ci:Enable corepack",
      "ci.yml:ci:Resolve the evidence root",
      "ci.yml:ci:Install dependencies",
      "ci.yml:ci:Build",
      "ci.yml:ci:Place the scheduled sweep's measurement",
      "ci.yml:ci:Place the suites' timings"
    ],
    "fitnessChecks": [
      {
        "scn": "SCN-FIT-001",
        "characteristic": "complexity",
        "command": "eslint"
      },
      {
        "scn": "SCN-FIT-014",
        "characteristic": "traceability",
        "command": "pnpm spec-controller tags"
      },
      {
        "scn": "SCN-FIT-009",
        "characteristic": "tech-conformance",
        "command": "pnpm lint:boundaries"
      },
      {
        "scn": "SCN-FIT-010",
        "characteristic": "traceability",
        "command": "pnpm lint:scn-subissues"
      },
      {
        "scn": "SCN-FIT-011",
        "characteristic": "typecheck",
        "command": "pnpm typecheck"
      },
      {
        "scn": "SCN-FIT-018",
        "characteristic": "lint",
        "command": "pnpm lint:publint"
      },
      {
        "scn": "SCN-FIT-019",
        "characteristic": "typecheck",
        "command": "pnpm lint:published-types"
      },
      {
        "scn": "SCN-FIT-020",
        "characteristic": "lint",
        "command": "docker://rhysd/actionlint:1.7.12"
      },
      {
        "scn": "SCN-FIT-021",
        "characteristic": "security",
        "command": "zizmorcore/zizmor-action@cc914d7f3750a2d13d75c7f184a1060aa0e9d482"
      },
      {
        "scn": "SCN-FIT-012",
        "characteristic": "ci-run-time",
        "command": "pnpm --silent timing:score --scn SCN-FIT-012",
        "atMost": 75
      },
      {
        "scn": "SCN-FIT-013",
        "characteristic": "ci-run-time",
        "command": "pnpm --silent timing:score --scn SCN-FIT-013",
        "atMost": 150
      },
      {
        "scn": "SCN-FIT-002",
        "characteristic": "mutation",
        "command": "pnpm --silent mutation:score --supersedes SCN-MUT-011",
        "atLeast": 95
      }
    ]
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@arethetypeswrong/cli": "0.18.5",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "publint": "0.3.24",
    "spec-controller": "0.1.0-alpha.3",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
