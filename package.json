{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "stryker run",
    "cucumber": "cucumber-js",
    "build": "pnpm -r build",
    "lint:boundaries": "depcruise packages && eslint --config eslint.boundaries.js --rule 'no-restricted-imports: off' .",
    "lint:seam": "eslint --config eslint.boundaries.js --rule 'no-restricted-syntax: off' tests/steps",
    "lint:publint": "publint --pack pnpm packages/core && publint --pack pnpm packages/spec-controller",
    "lint:published-types": "pnpm exec attw --profile esm-only \"$(pnpm --silent --filter @3f-consulting/spec-controller-core pack --pack-destination \"$(mktemp -d)\" | tail -1)\""
  },
  "specController": {
    "runners": {
      "unit": "vitest",
      "integration": "cucumber-js"
    },
    "notChecks": [
      "ci.yml:ci:Check out the repository",
      "ci.yml:ci:Set up Node",
      "ci.yml:ci:Enable corepack",
      "ci.yml:ci:Resolve the evidence root",
      "ci.yml:ci:Install dependencies",
      "ci.yml:ci:Build",
      "ci.yml:ci:Install Semgrep",
      "ci.yml:ci:New names this change introduces",
      "ci.yml:ci:Hand the built packages to the release"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@barney-media/crap-typescript": "1.0.0",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "cloc": "2.6.0-cloc",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "17.12.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "minimatch": "10.2.5",
    "publint": "0.3.24",
    "spec-controller": "0.1.40",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
