{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "ladder": "tsx packages/spec-controller/static-checks/localLadderCli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx packages/spec-controller/static-checks/timeStepCli.ts --scn SCN-CIP-013 --check ci-run-time -- vitest run",
    "mutation": "tsx packages/spec-controller/static-checks/mutationScoreCli.ts --scn SCN-MUT-011 --check mutation -- stryker run",
    "mutation:ratchet": "tsx packages/spec-controller/src/mutation-ratchet/ratchetCli.ts --gate domain --report reports/mutation/mutation.json --bank-command 'pnpm mutation:bank'",
    "mutation:bank": "pnpm mutation:ratchet --record",
    "cucumber": "tsx packages/spec-controller/static-checks/timeStepCli.ts --scn SCN-CIP-014 --check ci-run-time -- cucumber-js",
    "build": "pnpm -r build",
    "balance": "tsx packages/spec-controller/src/cli.ts",
    "audit:vocab": "tsx packages/spec-controller/static-checks/vocabAuditCli.ts",
    "lint:feature-codes": "tsx packages/spec-controller/static-checks/lintFeatureCodesCli.ts",
    "lint:complexity": "eslint",
    "lint:blocked-vocabulary": "tsx packages/spec-controller/static-checks/lintBlockedVocabularyCli.ts",
    "lint:complexity-exceptions": "tsx packages/spec-controller/static-checks/lintComplexityExceptionsCli.ts",
    "hygiene:no-committed-reports": "tsx packages/spec-controller/static-checks/hygieneNoCommittedReportsCli.ts",
    "lint:scn-tags": "tsx packages/spec-controller/static-checks/lintScnTagsCli.ts",
    "lint:scn-subissues": "tsx packages/spec-controller/static-checks/lintScnSubIssuesCli.ts",
    "lint:self-balance": "tsx packages/spec-controller/static-checks/lintSelfBalanceCli.ts",
    "lint:adopted-vocabulary": "tsx packages/spec-controller/static-checks/lintAdoptedVocabularyCli.ts",
    "lint:anemic-domain": "tsx packages/spec-controller/static-checks/lintAnemicDomainCli.ts",
    "lint:exempt-data-floor": "tsx packages/spec-controller/static-checks/lintExemptDataFloorCli.ts"
  },
  "specController": {
    "staticChecks": ["typecheck"],
    "checkRegistry": {
      "lint:feature-codes": { "check": "traceability", "scn": "SCN-LNT-011" },
      "lint:scn-tags": { "check": "traceability", "scn": "SCN-STG-006" },
      "lint:complexity": { "check": "complexity", "scn": "SCN-CPX-005" },
      "lint:complexity-exceptions": { "check": "complexity", "scn": "SCN-CPX-006" },
      "lint:blocked-vocabulary": { "check": "vocab", "scn": "SCN-VOC-019" },
      "typecheck": "typecheck",
      "lint:adopted-vocabulary": { "check": "vocab", "scn": "SCN-VOC-020" },
      "lint:exempt-data-floor": { "check": "vocab", "scn": "SCN-VOC-021" },
      "lint:anemic-domain": "tech-conformance",
      "lint:self-balance": "self-balance",
      "lint:scn-subissues": { "check": "traceability", "scn": "SCN-SSM-009" }
    },
    "thresholds": {
      "SCN-CIP-013": { "ci-run-time": 75 },
      "SCN-CIP-014": { "ci-run-time": 150 },
      "SCN-MUT-011": { "mutation": { "atLeast": { "mutationGate": "domain" } } }
    }
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "spec-controller": "workspace:*",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
