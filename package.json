{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "stryker run",
    "cucumber": "cucumber-js",
    "build": "pnpm -r build",
    "balance": "tsx packages/spec-controller/src/cli.ts",
    "audit:vocab": "tsx packages/spec-controller/static-checks/vocabAuditCli.ts",
    "lint:feature-codes": "tsx packages/spec-controller/static-checks/lintFeatureCodesCli.ts",
    "lint:complexity": "eslint",
    "lint:blocked-vocabulary": "tsx packages/spec-controller/static-checks/lintBlockedVocabularyCli.ts",
    "lint:complexity-exceptions": "tsx packages/spec-controller/static-checks/lintComplexityExceptionsCli.ts",
    "lint:no-committed-reports": "tsx packages/spec-controller/static-checks/lintNoCommittedReportsCli.ts",
    "lint:scn-tags": "tsx packages/spec-controller/static-checks/lintScnTagsCli.ts",
    "lint:scn-subissues": "tsx packages/spec-controller/static-checks/lintScnSubIssuesCli.ts",
    "lint:self-balance": "tsx packages/spec-controller/static-checks/lintSelfBalanceCli.ts",
    "lint:adopted-vocabulary": "tsx packages/spec-controller/static-checks/lintAdoptedVocabularyCli.ts"
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
