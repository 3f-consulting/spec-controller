{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "stryker run",
    "cucumber": "cucumber-js",
    "build": "pnpm -r build",
    "lint:scn-subissues": "tsx tests/checks/lintScnSubIssuesCli.ts",
    "lint:boundaries": "depcruise packages && eslint --config eslint.boundaries.mjs packages",
    "lint:publint": "publint --pack pnpm packages/core && publint --pack pnpm packages/spec-controller",
    "lint:published-types": "pnpm exec attw --profile esm-only \"$(pnpm --silent --filter @3f-consulting/spec-controller-core pack --pack-destination \"$(mktemp -d)\" | tail -1)\""
  },
  "specController": {
    "runners": {
      "unit": "vitest",
      "integration": "cucumber-js"
    },
    "notChecks": [
      "ci.yml:ci:actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
      "ci.yml:ci:actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
      "ci.yml:ci:Enable corepack",
      "ci.yml:ci:Resolve the evidence root",
      "ci.yml:ci:Install dependencies",
      "ci.yml:ci:Build"
    ]
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@arethetypeswrong/cli": "0.18.5",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "publint": "0.3.24",
    "spec-controller": "0.1.0-alpha.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
