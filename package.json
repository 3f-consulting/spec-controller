{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cucumber": "cucumber-js",
    "build": "pnpm -r build",
    "balance": "tsx packages/spec-controller/src/cli.ts",
    "audit:vocab": "tsx packages/spec-controller/static-guards/vocabAuditCli.ts",
    "lint:feature-codes": "tsx packages/spec-controller/static-guards/lintFeatureCodesCli.ts",
    "lint:no-committed-reports": "tsx packages/spec-controller/static-guards/lintNoCommittedReportsCli.ts"
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@cucumber/cucumber": "^12.9.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
