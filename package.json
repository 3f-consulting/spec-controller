{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-clones": "jscpd --config .jscpd-tests.json --fail-on-empty --no-tips",
    "mutation": "stryker run",
    "cucumber": "pnpm build && cucumber-js",
    "build": "pnpm -r build",
    "lint:publint": "publint --pack pnpm packages/core && publint --pack pnpm packages/spec-controller",
    "lint:published-types": "attw --profile esm-only \"$(pnpm --silent --filter @3f-consulting/spec-controller-core pack --pack-destination \"$(mktemp -d)\" | tail -1)\"",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:current-state": "bash -o pipefail -c 'files=$(git ls-files --cached --others --exclude-standard) && [ -n \"$files\" ] || { echo \"git listed no file for Vale to read\" >&2; exit 1; }; git ls-files -z --cached --others --exclude-standard | xargs -0 vale'",
    "docs:code-identifier": "vale --config=.vale/descriptions.ini --filter='.Name == \"Descriptions.CodeIdentifier\"' features",
    "docs:interface-mechanic": "vale --config=.vale/steps.ini features",
    "docs:references": "bash -o pipefail -c 'git ls-files -z -- \"*.md\" \"features/*.feature\" | xargs -0 remark --no-config --no-stdout --frail --quiet --use ./scripts/remark-feature-prose.mjs --use remark-validate-links'",
    "docs:file-links": "bash -o pipefail -c 'git ls-files -z -- \"*.md\" \"features/*.feature\" | xargs -0 vale --config=.vale/references.ini'"
  },
  "specController": {
    "runners": {
      "unit": "vitest",
      "integration": "cucumber-js",
      "e2e": "cucumber-js",
      "performance": null
    },
    "notChecks": [
      "ci.yml:ci:Check out the repository",
      "ci.yml:ci:Set up Node",
      "ci.yml:ci:Enable corepack",
      "ci.yml:ci:Resolve the evidence root",
      "ci.yml:ci:Install dependencies",
      "ci.yml:ci:Read the Python Semgrep runs on",
      "ci.yml:ci:Install Semgrep",
      "ci.yml:ci:Hand the built packages to the release"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@barney-media/crap-typescript": "1.0.0",
    "@cucumber/cucumber": "^12.9.0",
    "@cucumber/gherkin": "^41.0.0",
    "@eslint/json": "2.1.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "cloc": "2.6.0-cloc",
    "dependency-cruiser": "18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "17.12.0",
    "intl-messageformat": "12.1.4",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "publint": "0.3.24",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "spec-controller": "0.1.263",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
