{
  "name": "spec-controller-workspace",
  "version": "0.0.0",
  "description": "Workspace root for spec-controller — the reconciliation CLI and its pure core library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "ladder": "tsx tests/checks/localLadderCli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/checks/timeStepCli.ts --scn SCN-FIT-012 --check ci-run-time -- vitest run",
    "mutation": "tsx tests/checks/mutationScoreCli.ts --scn SCN-FIT-002 --check mutation -- stryker run",
    "mutation:score": "tsx tests/checks/mutationScoreReaderCli.ts --scn SCN-FIT-002 --check mutation",
    "timing:score": "tsx tests/checks/timingReaderCli.ts --check ci-run-time",
    "mutation:ratchet": "tsx packages/spec-controller/src/mutation-ratchet/ratchetCli.ts --gate domain --report reports/mutation/mutation.json --bank-command 'pnpm mutation:bank'",
    "mutation:bank": "pnpm mutation:ratchet --record",
    "cucumber": "tsx tests/checks/timeStepCli.ts --scn SCN-FIT-013 --check ci-run-time -- cucumber-js",
    "cucumber:fitness": "cucumber-js --profile fitness",
    "build": "pnpm -r build",
    "balance": "tsx packages/spec-controller/src/cli.ts",
    "balance:self": "tsx tests/checks/balanceSelfCli.ts",
    "audit:vocab": "tsx tests/checks/vocabAuditCli.ts",
    "lint:feature-codes": "tsx tests/checks/lintFeatureCodesCli.ts",
    "lint:blocked-vocabulary": "tsx tests/checks/lintBlockedVocabularyCli.ts",
    "lint:complexity-exceptions": "tsx tests/checks/lintComplexityExceptionsCli.ts",
    "lint:scn-tags": "tsx tests/checks/lintScnTagsCli.ts",
    "lint:scn-subissues": "tsx tests/checks/lintScnSubIssuesCli.ts",
    "lint:adopted-vocabulary": "tsx tests/checks/lintAdoptedVocabularyCli.ts",
    "lint:anemic-domain": "tsx tests/checks/lintAnemicDomainCli.ts",
    "lint:exempt-data-floor": "tsx tests/checks/lintExemptDataFloorCli.ts",
    "fitness:corpus": "tsx tests/checks/fitnessCorpus.ts",
    "doc:compatibility-examples": "tsx tests/checks/compatibilityExamplesCli.ts"
  },
  "specController": {
    "fitnessChecks": [
      { "scn": "SCN-FIT-001", "characteristic": "complexity", "command": "eslint" },
      {
        "scn": "SCN-FIT-003",
        "characteristic": "complexity",
        "command": "pnpm lint:complexity-exceptions"
      },
      {
        "scn": "SCN-FIT-004",
        "characteristic": "vocab",
        "command": "pnpm lint:blocked-vocabulary"
      },
      {
        "scn": "SCN-FIT-005",
        "characteristic": "vocab",
        "command": "pnpm lint:adopted-vocabulary"
      },
      {
        "scn": "SCN-FIT-006",
        "characteristic": "vocab",
        "command": "pnpm lint:exempt-data-floor"
      },
      {
        "scn": "SCN-FIT-007",
        "characteristic": "traceability",
        "command": "pnpm lint:feature-codes"
      },
      {
        "scn": "SCN-FIT-008",
        "characteristic": "traceability",
        "command": "pnpm lint:scn-tags"
      },
      {
        "scn": "SCN-FIT-009",
        "characteristic": "tech-conformance",
        "command": "pnpm lint:anemic-domain"
      },
      {
        "scn": "SCN-FIT-010",
        "characteristic": "traceability",
        "command": "pnpm lint:scn-subissues",
        "notExaminedExit": 3
      },
      { "scn": "SCN-FIT-011", "characteristic": "typecheck", "command": "pnpm typecheck" },
      {
        "scn": "SCN-FIT-012",
        "characteristic": "ci-run-time",
        "command": "pnpm --silent timing:score --scn SCN-FIT-012",
        "atMost": 75
      },
      {
        "scn": "SCN-FIT-013",
        "characteristic": "ci-run-time",
        "command": "pnpm --silent timing:score --scn SCN-FIT-013",
        "atMost": 150
      },
      {
        "scn": "SCN-FIT-002",
        "characteristic": "mutation",
        "command": "pnpm --silent mutation:score --supersedes SCN-MUT-011",
        "atLeast": { "mutationGate": "domain" }
      },
      {
        "scn": "SCN-FIT-014",
        "characteristic": "traceability",
        "command": "pnpm --silent fitness:corpus && git diff --exit-code -- features/fitness-checks.feature"
      },
      {
        "scn": "SCN-FIT-015",
        "characteristic": "doc-accuracy",
        "command": "pnpm --silent doc:compatibility-examples"
      }
    ]
  },
  "devDependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@cucumber/cucumber": "^12.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "spec-controller": "workspace:*",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
