#!/usr/bin/env bash
# Stands in for npm pack: serves $FAKE_NPM_DIR/<package dir>.tgz, fails as npm does when it is absent,
# fails the first N tries while $FAKE_NPM_DIR/<package dir>.fail holds N, and answers E404 to the first N
# while $FAKE_NPM_DIR/<package dir>.unserved holds N.
set -uo pipefail

[ "${1:-}" = pack ] || { echo "the stand-in npm runs pack alone" >&2; exit 1; }
spec=$2
destination=
shift 2
while [ $# -gt 0 ]; do
  case $1 in
    --pack-destination) destination=$2; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$destination" ] || { echo "the stand-in npm needs --pack-destination" >&2; exit 1; }

name=${spec%@*}
case $name in
  @3f-consulting/spec-controller-core) package=core ;;
  *) package=$name ;;
esac

failures="$FAKE_NPM_DIR/$package.fail"
if [ -f "$failures" ] && [ "$(cat "$failures")" -gt 0 ]; then
  echo $(($(cat "$failures") - 1)) > "$failures"
  echo "npm error code ETIMEDOUT" >&2
  echo "npm error network request to the registry failed, reason: timed out" >&2
  exit 1
fi

unserved="$FAKE_NPM_DIR/$package.unserved"
served="$FAKE_NPM_DIR/$package.tgz"
if [ -f "$unserved" ] && [ "$(cat "$unserved")" -gt 0 ]; then
  echo $(($(cat "$unserved") - 1)) > "$unserved"
  served=
fi
if [ ! -f "$served" ]; then
  echo "npm error code E404" >&2
  echo "npm error 404 Not Found - GET https://registry.npmjs.org/$name - Not found" >&2
  echo "npm error 404  '$spec' is not in this registry." >&2
  exit 1
fi
cp "$served" "$destination/$package.tgz"
echo "$package.tgz"
