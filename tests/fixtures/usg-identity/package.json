{
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint:sweep": "madge --circular",
    "lint:depth": "depcruise src",
    "lint:dump": "printf '%s' \"$STEPS_JSON\" > ci-steps.json",
    "lint:reconcile": "spec-controller balance --features features --ci ci.yml --package-json package.json --target usg-identity"
  },
  "specController": {
    "runners": {
      "unit": "vitest"
    },
    "notChecks": [
      "ci.yml:ci:actions/checkout@v4",
      "ci.yml:ci:Install dependencies",
      "ci.yml:ci:Build"
    ]
  }
}
