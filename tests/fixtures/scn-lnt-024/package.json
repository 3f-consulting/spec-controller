{
  "name": "measured-fitness-target-repo-fixture",
  "private": true,
  "scripts": {
    "build": "tsc"
  },
  "specController": {
    "fitnessChecks": [
      {
        "scn": "SCN-CVT-020",
        "characteristic": "ci-run-time",
        "command": "node -e \"const f=process.env.MEASUREMENT_RECORD,fs=require('fs');let h={measurements:[]};try{h=JSON.parse(fs.readFileSync(f,'utf8'))}catch(e){};h.measurements.push({scnId:'SCN-CVT-020',checkTag:'ci-run-time',measured:42.1});fs.writeFileSync(f,JSON.stringify(h))\"",
        "atMost": 100
      },
      {
        "scn": "SCN-CVT-021",
        "characteristic": "mutation",
        "command": "node -e \"const f=process.env.MEASUREMENT_RECORD,fs=require('fs');let h={measurements:[]};try{h=JSON.parse(fs.readFileSync(f,'utf8'))}catch(e){};h.measurements.push({scnId:'SCN-CVT-021',checkTag:'mutation',measured:240});fs.writeFileSync(f,JSON.stringify(h))\"",
        "atLeast": 90
      },
      {
        "scn": "SCN-CVT-022",
        "characteristic": "complexity",
        "command": "node -e \"console.error('swept 0 files')\"",
        "atMost": 12
      },
      {
        "scn": "SCN-CVT-023",
        "characteristic": "doc-accuracy",
        "command": "node -e \"const f=process.env.MEASUREMENT_RECORD,fs=require('fs');let h={measurements:[]};try{h=JSON.parse(fs.readFileSync(f,'utf8'))}catch(e){};h.measurements.push({scnId:'SCN-CVT-023',checkTag:'doc-accuracy',measured:'ninety'});fs.writeFileSync(f,JSON.stringify(h))\"",
        "atLeast": 1
      }
    ]
  }
}
