{
  "name": "spec-controller",
  "version": "0.1.0",
  "description": "Reconcile the behaviour your scenarios name against the evidence that actually ran — the deterministic `balance` CLI.",
  "keywords": [
    "reconciliation",
    "gherkin",
    "bdd",
    "evidence",
    "double-entry",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spec-controller": "./dist/cli.js",
    "spec-controller-restore-measurements": "./dist/measurements/restoreCli.js",
    "spec-controller-persist-measurements": "./dist/measurements/persistCli.js",
    "spec-controller-mutation-ratchet": "./dist/mutation-ratchet/ratchetCli.js"
  },
  "exports": {
    "./mutation-ratchet": "./src/mutation-ratchet/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@3f-consulting/spec-controller-core": "workspace:*",
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^34.0.1",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./mutation-ratchet": {
        "types": "./dist/mutation-ratchet/index.d.ts",
        "default": "./dist/mutation-ratchet/index.js"
      }
    }
  }
}
