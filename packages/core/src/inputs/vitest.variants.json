              "message": "",
              "assertionResults": [
                { "ancestorTitles": [], "title": "one", "status": "passed", "failureMessages": [] },
                { "ancestorTitles": [], "title": "two", "failureMessages": [] }
              ]
            }
          ]
        },
        "breaks": "$.testResults[0].assertionResults[1].status"
      },
      {
        "given": "an assertion result with a status neither Vitest nor Jest writes",
        "report": {
          "testResults": [
