{
  "name": "@3f-consulting/spec-controller-core",
  "version": "0.1.0",
  "description": "The pure, embeddable reconciliation core behind spec-controller — Gherkin/@SCN parse, the evidence model, reconcile primitives, and renderers. No CLI, no I/O.",
  "keywords": [
    "reconciliation",
    "gherkin",
    "bdd",
    "evidence",
    "double-entry",
    "spec-controller"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "spec-controller-build": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./internal": {
      "spec-controller-build": "./dist/internal.js",
      "default": "./src/internal.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^34.0.1",
    "intl-messageformat": "12.1.4",
    "unbash": "6.0.2",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
