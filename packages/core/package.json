{
  "name": "@3f-consulting/spec-controller-core",
  "version": "0.1.0-alpha.5",
  "description": "The pure, embeddable reconciliation core behind spec-controller — Gherkin/@SCN parse, the evidence model, reconcile primitives, and renderers. No CLI, no I/O.",
  "keywords": [
    "reconciliation",
    "gherkin",
    "bdd",
    "evidence",
    "double-entry",
    "spec-controller"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^34.0.1",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "fast-check": "4.10.1"
  }
}
